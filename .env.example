# Web terminal credentials (REQUIRED — change these!)
TTYD_USER=hermes
TTYD_PASSWORD=changeme

# Storage location
# Default: ./data (inside project folder)
# External drive: /mnt/usb/hermes-data, /mnt/nas/hermes, etc.
DATA_DIR=./data

# ── Sandbox hardening (optional) ──────────────────────────────────────
# Egress policy. DEFAULT (leave unset): the agent can reach the WHOLE
# internet (research, package installs, git, ...) on any port — the local
# network (RFC1918, Tailscale 100.64/10, link-local, metadata) is never
# reachable. Opt in to the default-deny ALLOWLIST proxy by setting its URL;
# then only hosts in ./data/egress-allowlist.conf are reachable:
#EGRESS_PROXY_URL=http://hermes-egress-proxy:8888
# Container runtime. Leave unset for plain runc. Set to runsc after
# installing gVisor for VM-grade syscall isolation (see README).
#HERMES_RUNTIME=runsc
# Resource caps for the agent container (protects the host, e.g. a media
# server, from runaway agent workloads).
#HERMES_MEM_LIMIT=2g
#HERMES_CPUS=2.0
