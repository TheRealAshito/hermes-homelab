# Web terminal credentials (REQUIRED — change these!)
TTYD_USER=hermes
TTYD_PASSWORD=changeme

# Storage location
# Default: ./data (inside project folder)
# External drive: /mnt/usb/hermes-data, /mnt/nas/hermes, etc.
DATA_DIR=./data

# ── Sandbox hardening (optional) ──────────────────────────────────────
# Container runtime. Leave unset for plain runc. Set to runsc after
# installing gVisor for VM-grade syscall isolation (see README).
#HERMES_RUNTIME=runsc
# Resource caps for the agent container (protects the host, e.g. a media
# server, from runaway agent workloads).
#HERMES_MEM_LIMIT=2g
#HERMES_CPUS=2.0
